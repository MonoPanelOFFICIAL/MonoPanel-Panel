# PLATFORM ENVIRONMENT CONFIGURATION EXAMPLE
# Copy or set these environment variables in your server / container deployment environment.

# JWT Secret used for signing admin and user authentication tokens.
# Leave EMPTY to auto-generate a strong one (stored in data/.jwt_secret, mode 600).
# Placeholder / short values are rejected on purpose. Generate one with:  openssl rand -base64 48
JWT_SECRET=""

# Key that encrypts secrets stored in the database (node daemon keys, Stripe keys).
# Leave EMPTY to auto-generate (data/.app_secret). BACK THIS UP: losing it means re-entering node/Stripe secrets.
APP_SECRET=""

# Initial Super Admin account (created on first start only).
# If you leave these unset the panel creates  admin@monopanel.com / MonoPanelOPP .
# These defaults are public: change the password right after your first login (or set your own values here).
MONOPANEL_ADMIN_EMAIL="admin@monopanel.com"
MONOPANEL_ADMIN_PASSWORD="MonoPanelOPP"

# Installation identity. Leave EMPTY to auto-generate once (it is then stored in the database).
MONOPANEL_INSTALLATION_ID=""

# Public site URL. REQUIRED in production: used for Stripe redirects, the webhook URL shown in Admin and OAuth callbacks.
APP_URL="http://localhost:3000"

# Reverse proxy hops to trust for client IPs (rate limits, bans). Default: 1 in production, 0 in development.
# Set to the number of proxies in front of the app (e.g. 1 for Nginx/Caddy, 2 for Cloudflare + Nginx), or "false".
TRUST_PROXY=""
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Anti-abuse / IP risk provider (Optional)
VPN_CHECK_API_KEY=""

# Discord OAuth2 App Credentials & Bot Integration (Optional)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:3000/api/v1/auth/discord/callback"
DISCORD_BOT_TOKEN=""

# Firebase Web App Credentials for Google Sign-In (Optional)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Node environment mode
NODE_ENV="development"

# MySQL / MariaDB host used by the "Databases" tab of each server (Optional).
# The admin account must be allowed to CREATE DATABASE, CREATE USER and GRANT. Leave DB_HOST_ADDRESS empty to hide database creation.
DB_HOST_ADDRESS=""
DB_HOST_PORT="3306"
DB_HOST_ADMIN_USER=""
DB_HOST_ADMIN_PASSWORD=""
# Address customers should connect to (defaults to DB_HOST_ADDRESS / DB_HOST_PORT)
DB_HOST_PUBLIC_ADDRESS=""
DB_HOST_PUBLIC_PORT=""

# ==============================================================
# DATABASE (PostgreSQL, required)
# MonoPanel stores everything in PostgreSQL, like Pterodactyl and Jexactyl need their database. There is no SQLite or
# JSON-file mode. Create an empty database and user first, e.g.:
#   CREATE USER monopanel WITH PASSWORD 'change-me';
#   CREATE DATABASE monopanel OWNER monopanel;
#   - Tables are created automatically on first start.
#   - Only ONE panel process may use a database (the panel keeps its working set in memory); a second one is refused on purpose.
#   - Needs PostgreSQL 12+. Back it up with pg_dump / point-in-time recovery / your provider's snapshots.
# ==============================================================
DATABASE_URL="postgres://monopanel:change-me@127.0.0.1:5432/monopanel"
# disable | require | verify | no-verify   (empty: whatever ?sslmode= in DATABASE_URL says). Managed databases usually need "require".
DATABASE_SSL=""
# Path to your provider's CA certificate (only if it is not publicly trusted)
DATABASE_SSL_CA=""
DATABASE_POOL_MAX="5"
# Table name prefix, handy when sharing one database with other apps
DATABASE_TABLE_PREFIX="mp_"

# HTTP port the panel listens on
PORT="3000"

# ==============================================================
# HOSTING TYPES
# Which kinds of hosting this panel sells: any of bot, vps, website, nodejs, lavalink (comma separated).
# This is the starting selection. The owner changes it any time from the website itself (Admin > Hosting Types): the site
# updates immediately, with no rebuild or restart. Once an admin has saved a selection there, that choice wins over this line.
# Leave empty to start with bot,vps (what earlier versions sold).
# ==============================================================
MONOPANEL_HOSTINGS="bot,vps,website,nodejs,lavalink"
